# This is a list of shaders that are to be imported
# Shaders must have the following variables:
# 'vertex' - filename of the vertex shader
# 'fragment' - filename of the fragment shader

"terrain" {
	"vertex" = "terrainvert.glsl";
	"fragment" = "terrainfrag.glsl";
}

"water" {
	"vertex" = "instancedvert.glsl";
	"fragment" = "waterfrag.glsl";
}

"skybox" {
	"vertex" = "skyboxvert.glsl";
	"fragment" = "skyboxfrag.glsl";
}

"nightskybox" {
	"vertex" = "skyboxvert.glsl";
	"fragment" = "nightskyboxfrag.glsl";
}

"tree" {
	"vertex" = "tree-vert.glsl";
	"fragment" = "textured-frag.glsl";
}

"textured" {
	"vertex" = "vert.glsl";
	"fragment" = "textured-frag.glsl";
}

"explosion" {
	"vertex" = "explosionvert.glsl";
	"fragment" = "explosionfrag.glsl";
}

"minimap" {
	"vertex" = "vert2d.glsl";
	"fragment" = "minimapfrag.glsl";
}

"attitude" {
	"vertex" = "vert2d.glsl";
	"fragment" = "attitudefrag.glsl";
}

"verticaltape" {
	"vertex" = "vert2d.glsl";
	"fragment" = "verticaltapefrag.glsl";
}

"fuel" {
	"vertex" = "vert2d.glsl";
	"fragment" = "fuelfrag.glsl";
}

"speed" {
	"vertex" = "vert2d.glsl";
	"fragment" = "speedfrag.glsl";
}

"textured2d" {
	"vertex" = "vert2d.glsl";
	"fragment" = "textured-simple-frag.glsl";
}

"dangeroverlay" {
	"vertex" = "vert2d.glsl";
	"fragment" = "dangerfrag.glsl";
}

"trail" {
	"vertex" = "trailvert.glsl";
	"fragment" = "textured-simple-frag.glsl";
}

"fog" {
	"vertex" = "fogvert.glsl";
	"fragment" = "fogfrag.glsl";
}
