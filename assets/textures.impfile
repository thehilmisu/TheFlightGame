# Warship texture (shared by both generated ship models, which are UV mapped
# into regions of this atlas)
"warship2" {
	"target" = "texture2d";
	"path" = "warship2.jpg";
	"flip" = "false";
}

# cubemap for skybox
"skybox" {
	"target" = "cubemap";
	"east" = "skybox_east.png";
	"west" = "skybox_west.png";
	"up" = "skybox_up.png";
	"down" = "skybox_down.png";
	"north" = "skybox_north.png";
	"south" = "skybox_south.png";
}

