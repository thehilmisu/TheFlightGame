# This is a list of textures to be imported
# Textures must have the following variables:
# target - this is either 'texture2d' or 'cubemap'
# if target is 'texture2d', the variables 'flip' and 'path'
# must be defined ('flip' determines if the texture should
# be flipped vertically and 'path' is the path to the
# texture relative to the executable)
# 
# If the target is 'cubemap' then you must provide 6 paths:
# east, west, up, down, north, south

# this is the texture for the terrain 
"terrain" {
	"target" = "texture2d";
	"path" = "terraintextures.png";
	"flip" = "false";
}

# this is the texture for water
"watermaps" {
	"target" = "texture2d";
	"path" = "watermaps.png";
	"flip" = "false";
}

# texture for pine tree
"pinetree" {
	"target" = "texture2d";
	"path" = "pinetreetexture.png";
	"flip" = "false";
}

# texture for tree
"tree" {
	"target" = "texture2d";
	"path" = "treetexture.png";
	"flip" = "false";
}

# texture for plane
"plane" {
	"target" = "texture2d";
	"path" = "planetexture.png";
	"flip" = "true";
}

# Generated player planes. displayPlayerPlane binds the texture by the model's
# name, so each one needs an entry here even though they share an atlas - a
# missing name makes bindTexture silently keep whatever was bound last.
"plane_falcon" {
	"target" = "texture2d";
	"path" = "planetexture.png";
	"flip" = "true";
}

"plane_marauder" {
	"target" = "texture2d";
	"path" = "planetexture.png";
	"flip" = "true";
}

"plane_lancet" {
	"target" = "texture2d";
	"path" = "planetexture.png";
	"flip" = "true";
}

"plane_warhog" {
	"target" = "texture2d";
	"path" = "planetexture.png";
	"flip" = "true";
}

# The rocket is UV mapped into the same atlas as the planes
"rocket" {
	"target" = "texture2d";
	"path" = "planetexture.png";
	"flip" = "true";
}

# texture for second  plane (a26)
"plane_douglas" {
	"target" = "texture2d";
	"path" = "gltf_embedded_1.jpeg";
	"flip" = "false";
}

# texture for enemy plane
"enemy_plane" {
	"target" = "texture2d";
	"path" = "enemyplanetexture.png";
	"flip" = "true";
}

# texture for propeller
"propeller" {
	"target" = "texture2d";
	"path" = "propellertexture.png";
	"flip" = "true";
}

# texture for balloon
"balloon" {
	"target" = "texture2d";
	"path" = "balloontexture.png";
	"flip" = "true";
}

# texture for blimp
"blimp" {
	"target" = "texture2d";
	"path" = "blimptexture.png";
	"flip" = "true";
}

# ufo texture
"ufo" {
	"target" = "texture2d";
	"path" = "ufotexture.png";
	"flip" = "true";
}

# explosion particle
"explosion_particle" {
	"target" = "texture2d";
	"path" = "explosionparticle.png";
	"flip" = "false";
}

# bullet texture
"bullet" {
	"target" = "texture2d";
	"path" = "bullettexture.png";
	"flip" = "false";
}

# player marker
"player_marker" {
	"target" = "texture2d";
